APP_NAME=KaisQr_server
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
API_KEY=your-api-key-here
CORS_ORIGINS=http://localhost:5171,http://127.0.0.1:5171,http://localhost:5173,http://127.0.0.1:5173,http://local.kaisweb.net
SESSION_TTL_SECONDS=600
MAX_DOCUMENTS_PER_SESSION=20
MAX_FILE_SIZE_BYTES=15728640
TEMPORARY_STORAGE_PATH=storage/temp
PUBLIC_WEBSOCKET_URL=ws://localhost:8000/api/v1/ws/v1

KAISVM_FORWARD_ENABLED=false
KAISVM_BASE_URL=http://localhost:3500/api
KAISVM_SERVICE_TOKEN=your-kaisvm-token-here

TRANSPORTE_FORWARD_ENABLED=false
TRANSPORTE_BASE_URL=http://localhost:3006/api
TRANSPORTE_SERVICE_KEY=your-transporte-key-here
